{
  "name": "PC-Free Windows Desktop",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [
    8006
  ],
  "portsAttributes": {
    "8006": {
      "label": "PC-Free Windows desktop",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash scripts/start-windows.sh",
  "remoteUser": "vscode",
  "runArgs": [
    "--privileged"
  ]
}
